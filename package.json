{
  "name": "jamly-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/setup-test-build.mjs && node .test-build/tests/run-tests.js",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase:apply-schema": "node scripts/apply-supabase-schema.mjs",
    "supabase:apply-migration": "node scripts/apply-supabase-migration.mjs",
    "retention:dry-run": "node scripts/run-retention-cleanup.mjs",
    "retention:execute": "node scripts/run-retention-cleanup.mjs --execute --confirm RUN_RETENTION_CLEANUP",
    "brand:generate-favicon": "node scripts/generate-jamly-favicon.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "pg": "^8.16.3",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
