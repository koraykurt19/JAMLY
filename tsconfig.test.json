{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "target": "ES2020"
  },
  "include": ["src/lib/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "backups", "outputs", "work", ".next", ".test-build"]
}
