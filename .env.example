# Jamly public frontend variables.
# Leave these empty for demo mode.
# For live Supabase mode, paste the Project URL and publishable/anon public key from:
# Supabase Dashboard -> Project Settings -> API
# Never put sb_secret/service_role keys in frontend env files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional deployment label shown by /api/health. Use "self-hosted" on IIS.
JAMLY_DEPLOYMENT=

# Optional build metadata for deployments that do not keep a .git directory.
# Normal git checkouts do not need these.
JAMLY_BUILD_ID=
JAMLY_SOURCE_REVISION=

# Production rate-limit identity salt. Use a long random value outside demo mode.
RATE_LIMIT_SALT=

# Trusted server key. Required for sandbox settlement, webhooks and queued
# transactional email. Never expose it with a NEXT_PUBLIC_ prefix or commit a
# real value.
SUPABASE_SERVICE_ROLE_KEY=

# Test payment panel. Keep false in production unless you intentionally want a
# no-money sandbox. A live provider automatically disables this endpoint.
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENTS_ENABLED=false
PAYMENT_WEBHOOK_SECRET=

# Public production origin used in app auth callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public pre-register origin used for waitlist and verification links.
NEXT_PUBLIC_PRE_REGISTER_SITE_URL=http://localhost:3000

# Optional Google Search Console HTML tag token. Paste only the content value,
# not the whole meta tag.
GOOGLE_SITE_VERIFICATION=

# Jamly sender identities. These addresses are not secrets.
EMAIL_FROM_NAME=Jamly
EMAIL_FROM_ADDRESS=noreply@getjamly.com
EMAIL_REPLY_TO_ADDRESS=support@getjamly.com

# Optional SMTP delivery. Leave empty to keep messages queued in email_outbox.
# Configure the same sender in Supabase Auth SMTP settings for password reset
# and login magic-link emails sent by Supabase.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SUPPRESSED_RECIPIENT_DOMAINS=example.com,example.net,example.org,invalid.test,test

# Optional local migration connection. This is server-only and must never use a
# NEXT_PUBLIC_ prefix. Prefer SUPABASE_DATABASE_URL; DATABASE_URL is supported
# as a compatibility fallback. Keep both empty unless running migration scripts.
SUPABASE_DATABASE_URL=
# DATABASE_URL=

# Docker Compose local port. Change only if port 3000 is already used.
APP_PORT=3000
